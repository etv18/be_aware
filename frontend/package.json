{
  "name": "be-aware-frontend",
  "private": true,
  "description": "Builds the CSS (Tailwind) and the icon sprite of Be Aware. The pages themselves need no build step.",
  "scripts": {
    "build": "npm run build:css && npm run build:icons",
    "build:css": "tailwindcss -c tailwind.config.js -i src/app.css -o ../app/static/css/app.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/app.css -o ../app/static/css/app.css --watch",
    "build:icons": "node scripts/build-icons.mjs"
  },
  "devDependencies": {
    "chart.js": "4.4.7",
    "flatpickr": "^4.6.13",
    "lucide-static": "0.469.0",
    "tailwindcss": "3.4.17"
  }
}
